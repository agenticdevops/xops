{
  "name": "@opspilot/cli",
  "version": "0.1.0",
  "description": "OpsPilot CLI - Your 24/7 DevOps Copilot",
  "type": "module",
  "bin": {
    "opspilot": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@opspilot/core": "workspace:*",
    "@opspilot/wizard": "workspace:*",
    "@opspilot/gateway": "workspace:*",
    "@opspilot/memory": "workspace:*",
    "commander": "^13.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
